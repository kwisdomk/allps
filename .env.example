# Copy to .env locally; use Render secret environment variables on the server.
# Load locally with: uvicorn allps.web.deployment:create_hosted_app --factory --env-file .env
ALLPS_AI_BASE_URL=https://api.tokenlab.amd.com/v1
ALLPS_AI_PROVIDER=AMD Token Lab
ALLPS_AI_MODEL=Gemma-4-31B-IT
ALLPS_AI_API_KEY=
ALLPS_SESSION_SECRET=
# Absolute path; on Render this must be on the persistent disk.
ALLPS_DB_PATH=Q:/ALLPS/data/runtime/hosted-demo.db
ALLPS_SYNTHETIC_DEMO=true
# Use assigned synthetic IDs for the synthetic class workflow; unique strong passwords.
ALLPS_TEACHERS_JSON=[]
